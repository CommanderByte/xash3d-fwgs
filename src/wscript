			'filesystem_registry_snapshot': '../tests/filesystem/registry_snapshot.cpp',
			'filesystem_search_result_builder': '../tests/filesystem/search_result_builder.cpp',
			'filesystem_valve_path_resolver': '../tests/filesystem/valve_path_resolver.cpp',
