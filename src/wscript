		for i in tests:
			bld.program(features = 'test',
				source = tests[i],
				target = 'test_%s' % i,
				use = 'modern_filesystem modern_launcher modern_engine modern_utilities modern_debugging modern_debugging_includes sdk_includes werror PTHREAD DL',
				install_path = None)
