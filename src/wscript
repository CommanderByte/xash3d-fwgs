			'filesystem_zip_backend': '../tests/filesystem/zip_backend.cpp',
			'launcher_application': '../tests/launcher/application.cpp',
			'launcher_engine_library': '../tests/launcher/engine_library.cpp',
			'launcher_launch_settings': '../tests/launcher/launch_settings.cpp',
			'utilities_atlas': '../tests/utilities/atlas.cpp',
			'utilities_build_number': '../tests/utilities/build_number.cpp',
			'utilities_conversion': '../tests/utilities/conversion.cpp',
			'utilities_hash': '../tests/utilities/hash.cpp',
			'utilities_md5': '../tests/utilities/md5.cpp',
