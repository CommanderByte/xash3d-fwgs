#!/usr/bin/env python

from waflib.extras import pthread

def options(opt):
	grp = opt.add_option_group('Game launcher options')

	grp.add_option('--disable-menu-changegame', action = 'store_true', dest = 'DISABLE_MENU_CHANGEGAME', default = False,
		help = 'disable changing the game from the menu [default: %(default)s]')

def configure(conf):
	if conf.env.DEST_OS == 'win32':
		conf.load('winres')

	if not conf.env.DEST_OS in ['win32', 'android']:
		conf.check_pthreads(mode='c')

	conf.define('XASH_DISABLE_MENU_CHANGEGAME', conf.options.DISABLE_MENU_CHANGEGAME)

def build(bld):
	bld(name = 'modern_debugging_includes',
		export_includes = 'include')

	bld.stlib(target = 'modern_debugging',
		source = bld.path.ant_glob('debugging/*.cpp'),
		use = 'modern_debugging_includes werror')

	bld.stlib(target = 'modern_utilities',
		source = bld.path.ant_glob('utilities/*.cpp'),
		includes = 'include',
		use = 'werror',
		export_includes = 'include')

	launcher_sources = bld.path.ant_glob('launcher/*.cpp')

	if bld.env.DEST_OS == 'win32':
		launcher_sources += [
			'launcher/platform/library_win32.cpp',
			'launcher/platform/win32_argv.cpp',
		]
	else:
		launcher_sources += ['launcher/platform/library_posix.cpp']

	if bld.env.SAILFISH:
		launcher_sources += ['launcher/platform/environment_sailfish.cpp']
	else:
		launcher_sources += ['launcher/platform/environment_default.cpp']

	bld.stlib(target = 'modern_launcher',
		source = launcher_sources,
		use = 'modern_debugging_includes sdk_includes werror',
		export_includes = 'include')

	bld.stlib(target = 'modern_filesystem',
		source = bld.path.ant_glob('filesystem/*.cpp'),
		use = 'modern_debugging modern_debugging_includes sdk_includes werror')

	bld.stlib(target = 'modern_engine',
		source = bld.path.ant_glob('engine/**/*.cpp'),
		use = 'modern_utilities modern_debugging_includes werror',
		export_includes = 'include')

	if bld.env.LAUNCHER:
		source = ['launcher/platform/entry.cpp']
		linkflags = []

		if bld.env.DEST_OS == 'win32':
			source += ['../resources/launcher/windows/game.rc']

		# Half-Life 25th anniversary update doesn't have server library explicitly linked to libm
		if bld.env.DEST_OS == 'linux':
			linkflags += ['-Wl,--no-as-needed', '-lm']

		bld.program(source = source,
			target   = 'xash3d', # hl.exe
			use      = 'modern_launcher sdk_includes DL USER32 SHELL32 werror',
			linkflags = linkflags,
			rpath    = bld.env.DEFAULT_RPATH,
			install_path = bld.env.BINDIR,
			subsystem = bld.env.MSVC_SUBSYSTEM
		)

	if bld.env.TESTS:
		tests = {
			'debugging': '../tests/debugging/debugging.cpp',
			'engine_base_command_registry': '../tests/engine/base_command_registry.cpp',
			'engine_command_buffer': '../tests/engine/command_buffer.cpp',
			'engine_client_command_dispatch': '../tests/engine/client_command_dispatch.cpp',
			'engine_connectionless_classifier': '../tests/engine/connectionless_classifier.cpp',
			'engine_connection_response': '../tests/engine/connection_response.cpp',
			'engine_filesystem_mount_flags': '../tests/engine/filesystem_mount_flags.cpp',
			'engine_info_string': '../tests/engine/info_string.cpp',
			'engine_network_buffer': '../tests/engine/network_buffer.cpp',
			'engine_netapi_info': '../tests/engine/netapi_info.cpp',
			'engine_platform_console_backend': '../tests/engine/platform_console_backend.cpp',
			'engine_platform_command_line': '../tests/engine/platform_command_line.cpp',
			'engine_platform_current_user': '../tests/engine/platform_current_user.cpp',
			'engine_resource_identity': '../tests/engine/resource_identity.cpp',
			'engine_server_consistency_list': '../tests/engine/server_consistency_list.cpp',
			'engine_server_consistency_policy': '../tests/engine/server_consistency_policy.cpp',
			'engine_server_resource_catalog': '../tests/engine/server_resource_catalog.cpp',
			'engine_server_hot_resource': '../tests/engine/server_hot_resource.cpp',
			'engine_server_reslist_policy': '../tests/engine/server_reslist_policy.cpp',
			'engine_server_userinfo_message': '../tests/engine/server_userinfo_message.cpp',
			'engine_server_service_messages': '../tests/engine/server_service_messages.cpp',
			'engine_server_voice_relay': '../tests/engine/server_voice_relay.cpp',
			'engine_server_customization_message': '../tests/engine/server_customization_message.cpp',
			'engine_server_resource_message': '../tests/engine/server_resource_message.cpp',
			'engine_server_download_policy': '../tests/engine/server_download_policy.cpp',
			'engine_server_upload_queue': '../tests/engine/server_upload_queue.cpp',
			'engine_server_filter': '../tests/engine/server_filter.cpp',
			'engine_server_event_log': '../tests/engine/server_event_log.cpp',
			'engine_source_query': '../tests/engine/source_query.cpp',
			'engine_system_console_message': '../tests/engine/system_console_message.cpp',
