{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 16, "patch": 0 },

    "configurePresets": [
        {
            "name": "debug-msvc",
            "displayName": "Debug · MSVC x64",
            "description": "Debug build with tests — Visual Studio 17 2022, x64",
            "generator": "Visual Studio 17 2022",
            "architecture": { "value": "x64", "strategy": "set" },
            "binaryDir": "${sourceDir}/build/Debug",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "XASH3DPP_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "debug-msvc-x86",
            "displayName": "Debug · MSVC Win32 (x86)",
            "description": "32-bit Debug build with tests — for loading the retail 32-bit GoldSrc dlls/hl.dll (S15 milestone). Validates the vendored ABI's both-pointer-widths design + the OQ-6 32-bit string-pool path.",
            "generator": "Visual Studio 17 2022",
            "architecture": { "value": "Win32", "strategy": "set" },
            "binaryDir": "${sourceDir}/build/Debug-x86",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "XASH3DPP_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "clangd",
            "displayName": "clangd · compile_commands.json",
            "description": "Ninja configure whose only purpose is emitting compile_commands.json for clangd/LSP tooling (the VS generator ignores CMAKE_EXPORT_COMPILE_COMMANDS). Run from a VS x64 dev prompt (VsDevCmd -arch=x64) so cl/ninja are on PATH. Never build from this tree.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/clangd",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "XASH3DPP_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "release-msvc",
            "displayName": "Release · MSVC x64",
            "description": "Optimised release build — Visual Studio 17 2022, x64",
            "generator": "Visual Studio 17 2022",
            "architecture": { "value": "x64", "strategy": "set" },
            "binaryDir": "${sourceDir}/build/Release",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "XASH3DPP_BUILD_TESTS": "OFF"
            }
        }
    ],

    "buildPresets": [
        {
            "name": "debug",
            "displayName": "Build Debug",
            "configurePreset": "debug-msvc",
            "configuration": "Debug"
        },
        {
            "name": "release",
            "displayName": "Build Release",
            "configurePreset": "release-msvc",
            "configuration": "Release"
        },
        {
            "name": "debug-x86",
            "displayName": "Build Debug (x86)",
            "configurePreset": "debug-msvc-x86",
            "configuration": "Debug"
        }
    ],

    "testPresets": [
        {
            "name": "debug",
            "displayName": "Test Debug",
            "configurePreset": "debug-msvc",
            "configuration": "Debug",
            "output": { "outputOnFailure": true },
            "execution": { "jobs": 1 }
        },
        {
            "name": "debug-x86",
            "displayName": "Test Debug (x86)",
            "configurePreset": "debug-msvc-x86",
            "configuration": "Debug",
            "output": { "outputOnFailure": true },
            "execution": { "jobs": 1 }
        }
    ]
}
